---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Skills from '../components/Skills.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import CareerMap from '../components/CareerMap.astro';
import ChatWidget from '../components/ChatWidget.astro';

import { getEntry } from 'astro:content';

const resumeData = await getEntry('resume', 'me');
let data;
if (resumeData && resumeData.data) {
  data = resumeData.data;
} else {
  // Read directly from file in dev mode if collections fail to sync properly
  const fs = await import('fs' as any);
  data = JSON.parse(fs.readFileSync('data/resume.json', 'utf-8')).me;
}
if (!data) throw new Error('Could not load resume data');
---

<Layout title={`${data.basics.name} - ${data.basics.title}`}>
  <Navigation />

  <main class="container mx-auto px-4 max-w-5xl pt-32 pb-24 relative">

    <div id="page-home" class="page active">
        <Hero
            name={data.basics.name}
            title={data.basics.title}
            shortBio={data.basics.shortBio}
            links={data.basics.links}
        />

        <Skills skills={data.skills} />
    </div>

    <Experience experience={data.experience} />

    <Projects projects={data.projects} />

  </main>

  <CareerMap experience={data.experience} />

  <ChatWidget />
</Layout>