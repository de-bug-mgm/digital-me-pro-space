---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  name: string;
}

const { name } = Astro.props;
---

<header class="sticky top-0 z-50 w-full border-b border-gray-200 dark:border-gray-800 bg-white/80 dark:bg-gray-950/80 backdrop-blur">
  <div class="container mx-auto px-4 h-16 flex items-center justify-between">
    <a href="/" class="text-xl font-bold tracking-tight">
      {name}
    </a>
    <ThemeToggle />
  </div>
</header>