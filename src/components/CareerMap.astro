---
interface Experience {
    company: string;
    role: string;
    period: string;
    highlights: string[];
}

interface Props {
    experience: Experience[];
}

const { experience } = Astro.props;
---

<section id="page-experience" class="w-full my-12 relative page">
    <div class="mb-12 flex justify-between items-end">
        <div>
            <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-3">Work Experience</h2>
            <p class="text-slate-600 dark:text-slate-400">A timeline of my professional journey.</p>
        </div>
        <div class="hidden lg:block">
            <button id="toggle-timeline-btn" class="px-5 py-2 bg-slate-200 dark:bg-slate-800 rounded-xl text-sm font-bold text-slate-800 dark:text-slate-200 hover:bg-slate-300 dark:hover:bg-slate-700 transition-colors shadow-sm">
                View Timeline
            </button>
        </div>
    </div>

    <!-- Mobile & Tablet View: Vertical Timeline -->
    <div id="mobile-timeline-wrapper" class="block lg:hidden space-y-8 border-l-2 border-slate-200 dark:border-slate-800 ml-3 pl-8">
        {experience.map((job, index) => (
            <div class="relative">
                <div class={`absolute w-4 h-4 rounded-full ${index === 0 ? 'bg-brand-500' : 'bg-slate-300 dark:bg-slate-700'} -left-[41px] top-1.5 border-4 border-slate-50 dark:border-slate-950`}></div>
                <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline mb-2">
                    <h3 class="text-xl font-bold text-slate-900 dark:text-white">{job.role}</h3>
                    <span class={`text-sm font-semibold ${index === 0 ? 'text-brand-500 bg-brand-50 dark:bg-brand-500/10' : 'text-slate-500 bg-slate-100 dark:bg-slate-800'} px-3 py-1 rounded-full w-max mt-2 sm:mt-0`}>{job.period}</span>
                </div>
                <h4 class="text-lg font-medium text-slate-700 dark:text-slate-300 mb-4 flex items-center gap-2">
                    <i class="ph-fill ph-buildings"></i> {job.company}
                </h4>
                <div class="text-slate-600 dark:text-slate-400 leading-relaxed bg-white dark:bg-slate-900 p-5 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm">
                    <ul class="list-disc pl-5 space-y-1">
                        {job.highlights.map(highlight => (
                            <li>{highlight}</li>
                        ))}
                    </ul>
                </div>
            </div>
        ))}
    </div>

    <!-- Desktop View: Interactive Career Journey -->
    <div class="hidden lg:block relative w-full h-[600px] bg-slate-950 rounded-2xl overflow-hidden border border-slate-800 shadow-2xl" id="desktop-journey-container">

        <!-- Controls HUD -->
        <div class="absolute top-0 left-0 right-0 p-6 flex justify-between items-center z-20 bg-gradient-to-b from-slate-950 via-slate-950/80 to-transparent">
            <div>
                <h2 class="text-xl font-extrabold text-white flex items-center gap-2">
                    <i class="ph-fill ph-game-controller text-brand-400"></i> Interactive Career Journey
                </h2>
            </div>

            <div class="flex items-center gap-3">
                <button id="journey-prev-btn" class="w-10 h-10 rounded-full bg-slate-800/80 hover:bg-slate-700 text-white flex items-center justify-center transition-colors border border-slate-700">
                    <i class="ph-bold ph-caret-left"></i>
                </button>
                <button id="journey-play-btn" class="px-4 py-2 rounded-full bg-brand-500 hover:bg-brand-400 text-slate-950 font-bold text-xs flex items-center gap-1.5 transition-all shadow-lg shadow-brand-500/20">
                    <i id="journey-play-icon" class="ph-fill ph-play"></i> <span id="journey-play-text">Auto Play</span>
                </button>
                <button id="journey-next-btn" class="w-10 h-10 rounded-full bg-slate-800/80 hover:bg-slate-700 text-white flex items-center justify-center transition-colors border border-slate-700">
                    <i class="ph-bold ph-caret-right"></i>
                </button>
            </div>
        </div>

        <!-- Scrollable Camera Container World -->
        <div id="journey-viewport" class="w-full h-full relative overflow-hidden bg-slate-950">
            <!-- Background Stars / Grid -->
            <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b15_1px,transparent_1px),linear-gradient(to_bottom,#1e293b15_1px,transparent_1px)] bg-[size:40px_40px]"></div>

            <!-- Moving World Track Layer -->
            <div id="journey-world" class="absolute top-0 left-0 h-full w-[2800px] transition-transform duration-700 ease-in-out will-change-transform">

                <!-- SVG Pathway Line -->
                <svg id="journey-svg-canvas" width="2800" height="600" viewBox="0 0 2800 600" class="absolute inset-0 w-full h-full pointer-events-none">
                    <defs>
                        <linearGradient id="path-grad" x1="0%" y1="0%" x2="100%" y2="0%">
                            <stop offset="0%" stop-color="#38bdf8" />
                            <stop offset="50%" stop-color="#14b8a6" />
                            <stop offset="100%" stop-color="#a855f7" />
                        </linearGradient>
                    </defs>
                    <!-- Background Guide Track -->
                    <path id="journey-bg-path" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="12" stroke-linecap="round"/>
                    <!-- Active Path -->
                    <path id="journey-active-path" fill="none" stroke="url(#path-grad)" stroke-width="8" stroke-linecap="round" stroke-dasharray="0" stroke-dashoffset="0"/>
                </svg>

                <!-- Container for Milestone Cards -->
                <div id="journey-milestones-container" class="absolute inset-0 w-full h-full pointer-events-none">
                    {experience.map((job, index) => (
                        <div class="absolute -translate-x-1/2 -translate-y-1/2 flex flex-col items-center stage-card pointer-events-auto opacity-0 transition-all duration-500" data-index={index} data-state="upcoming">
                            <div class="w-14 h-14 rounded-2xl bg-slate-900 border-2 border-slate-700 text-slate-500 flex items-center justify-center text-2xl shadow-xl mb-3 cursor-pointer transition-all duration-500 stage-icon relative" data-index={index}>
                                <i class="ph-fill ph-buildings stage-icon-inner"></i>
                                <div class="absolute -bottom-2 -right-2 w-6 h-6 bg-emerald-500 rounded-full border-2 border-slate-900 flex items-center justify-center text-white opacity-0 transition-opacity duration-300 stage-checkmark">
                                    <i class="ph-bold ph-check text-xs"></i>
                                </div>
                            </div>
                            <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-4 text-center w-64 shadow-2xl backdrop-blur-md transition-all duration-500 stage-details cursor-pointer overflow-hidden h-[90px]">
                                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 stage-period">{job.period}</span>
                                <h4 class="text-base font-extrabold text-slate-300 stage-company">{job.company}</h4>
                                <p class="text-xs font-semibold text-slate-500 stage-role">{job.role}</p>
                                <div class="mt-4 text-left opacity-0 transition-opacity duration-500 stage-expanded-content">
                                    <ul class="list-disc pl-4 space-y-1 text-slate-400 text-xs">
                                        {job.highlights.map(highlight => (
                                            <li>{highlight}</li>
                                        ))}
                                    </ul>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>

                <!-- Dynamic Character Sprite -->
                <div id="journey-avatar" class="absolute top-0 left-0 w-12 h-16 transition-all duration-75 z-30" style="offset-path: path('M0,0'); offset-distance: 0%; offset-rotate: auto 90deg;">
                    <svg viewBox="0 0 40 60" class="w-full h-full drop-shadow-[0_10px_10px_rgba(0,0,0,0.5)]">
                        <g class="char-body-bounce">
                            <circle cx="20" cy="15" r="10" fill="#cbd5e1"/>
                            <path d="M 8 15 A 12 12 0 0 1 32 15" fill="none" stroke="#14b8a6" stroke-width="4" stroke-linecap="round"/>
                            <rect x="6" y="12" width="5" height="8" rx="2" fill="#14b8a6"/>
                            <rect x="29" y="12" width="5" height="8" rx="2" fill="#14b8a6"/>
                        </g>
                        <g class="char-body-bounce">
                            <rect x="12" y="25" width="16" height="20" rx="4" fill="#334155"/>
                            <rect x="10" y="28" width="20" height="12" rx="3" fill="#1e293b"/>
                            <circle cx="20" cy="34" r="3" fill="#38bdf8" class="animate-pulse"/>
                        </g>
                    </svg>
                </div>
            </div>

            <!-- Scrubber Progress Bar -->
            <div class="absolute bottom-6 left-1/2 -translate-x-1/2 w-[90%] max-w-2xl">
                <div class="h-2 w-full bg-slate-800 rounded-full overflow-hidden shadow-inner cursor-pointer" id="journey-scrubber-bg">
                    <div id="journey-progress-bar" class="h-full bg-gradient-to-r from-cyan-500 to-brand-500 w-0 transition-all duration-300 rounded-full"></div>
                </div>
                <!-- Mini nodes for scrubber -->
                <div id="journey-scrubber-nodes" class="absolute top-1/2 -translate-y-1/2 left-0 w-full h-0 pointer-events-none"></div>
            </div>
        </div>
    </div>
</section>

<!-- Pass experience data to client-side script -->
<style>
    .stage-card {
        transform: translate(-50%, -50%);
    }
    .stage-card[data-state="upcoming"] {
        transform: translate(-50%, -50%) scale(0.9);
        filter: saturate(0.2) opacity(0.8);
    }
    .stage-card[data-state="active"] {
        transform: translate(-50%, -50%) scale(1.05);
        filter: saturate(1) opacity(1);
        z-index: 40;
    }
    .stage-card[data-state="completed"] {
        transform: translate(-50%, -50%) scale(0.95);
        filter: saturate(0.8) opacity(0.9);
    }

    .stage-card[data-state="active"] .stage-icon {
        border-color: #38bdf8;
        color: #38bdf8;
        box-shadow: 0 0 20px rgba(56, 189, 248, 0.4);
    }
    .stage-card[data-state="completed"] .stage-icon {
        border-color: #14b8a6;
        color: #14b8a6;
    }

    .stage-card[data-state="active"] .stage-details {
        background-color: rgba(15, 23, 42, 0.95);
        border-color: #38bdf8;
        height: 200px;
        overflow-y: auto;
    }
    .stage-card[data-state="active"] .stage-period { color: #38bdf8; }
    .stage-card[data-state="active"] .stage-company { color: #ffffff; }
    .stage-card[data-state="active"] .stage-expanded-content { opacity: 1; }
    .stage-card[data-state="completed"] .stage-checkmark { opacity: 1; }
</style>

<script is:inline define:vars={{ experienceData: experience }}>
    window.careerExperienceData = experienceData;
</script>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const data = window.careerExperienceData || [];
        const count = data.length;

        const spacingX = 600;
        const paddingX = 200;

        const worldWidth = paddingX * 2 + (count - 1) * spacingX;
        const world = document.getElementById('journey-world');
        const svgCanvas = document.getElementById('journey-svg-canvas');
        const bgPath = document.getElementById('journey-bg-path');
        const activePath = document.getElementById('journey-active-path');

        if(world) world.style.width = `${Math.max(window.innerWidth, worldWidth)}px`;
        if(svgCanvas) {
            svgCanvas.setAttribute('width', Math.max(window.innerWidth, worldWidth));
            svgCanvas.setAttribute('viewBox', `0 0 ${Math.max(window.innerWidth, worldWidth)} 600`);
        }

        let pathD = "";
        const points = [];
        for(let i=0; i<count; i++) {
            const reversedIndex = count - 1 - i;
            const cx = paddingX + (reversedIndex * spacingX);
            const cy = (reversedIndex % 2 === 0) ? 450 : 150;
            points.push({x: cx, y: cy, origIndex: i});
        }

        points.sort((a,b) => a.x - b.x);

        if(points.length > 0) {
            pathD = `M ${points[0].x} ${points[0].y}`;
            for(let i=1; i<points.length; i++) {
                const prev = points[i-1];
                const curr = points[i];
                const controlX = (prev.x + curr.x) / 2;
                pathD += ` C ${controlX} ${prev.y}, ${controlX} ${curr.y}, ${curr.x} ${curr.y}`;
            }
        }

        if(bgPath) bgPath.setAttribute('d', pathD);
        if(activePath) {
            activePath.setAttribute('d', pathD);
            const totalLength = activePath.getTotalLength();
            activePath.style.strokeDasharray = totalLength;
            activePath.style.strokeDashoffset = totalLength;
        }

        const avatar = document.getElementById('journey-avatar');
        if (avatar) {
            avatar.style.offsetPath = `path('${pathD}')`;
        }

        const cards = document.querySelectorAll('.stage-card');
        cards.forEach(card => {
            const idx = parseInt(card.getAttribute('data-index'));
            const point = points.find(p => p.origIndex === idx);
            if(point) {
                card.style.left = `${point.x}px`;
                card.style.top = `${point.y}px`;
                card.style.opacity = '1';
            }
        });

        // Auto-play Step-and-Hold Logic
        let activeIndex = 0;
        let isPlaying = false;
        let animationFrame = null;
        let holdTimeout = null;
        let currentProgress = 0;

        const totalNodes = points.length;

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const MOVE_DURATION = prefersReducedMotion ? 0 : 2500;
        const HOLD_DURATION = prefersReducedMotion ? 9999999 : 6000;

        if (prefersReducedMotion) {
            const playBtn = document.getElementById('journey-play-btn');
            if (playBtn) playBtn.style.display = 'none';

            const style = document.createElement('style');
            style.innerHTML = `
                .stage-expanded-content { opacity: 1 !important; }
                .stage-details { height: auto !important; background-color: rgba(15, 23, 42, 0.95) !important; }
            `;
            document.head.appendChild(style);
        }

        function updateMilestoneStates() {
            cards.forEach(card => {
                const idx = parseInt(card.getAttribute('data-index'));
                const pointIndex = points.findIndex(p => p.origIndex === idx);

                if (pointIndex < activeIndex) {
                    card.setAttribute('data-state', 'completed');
                } else if (pointIndex === activeIndex) {
                    card.setAttribute('data-state', 'active');
                } else {
                    card.setAttribute('data-state', 'upcoming');
                }
            });
        }

        function animateToNode(targetIndex) {
            const startProgress = currentProgress;
            const targetProgress = targetIndex / (Math.max(1, totalNodes - 1));
            const startTime = performance.now();

            cards.forEach(card => {
                const idx = parseInt(card.getAttribute('data-index'));
                const pointIndex = points.findIndex(p => p.origIndex === idx);
                if (pointIndex < targetIndex) card.setAttribute('data-state', 'completed');
                else card.setAttribute('data-state', 'upcoming');
            });

            function step(currentTime) {
                const elapsed = currentTime - startTime;
                let t = elapsed / MOVE_DURATION;
                if (t > 1) t = 1;

                const easeInOut = t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t;
                currentProgress = startProgress + (targetProgress - startProgress) * easeInOut;

                if(avatar) avatar.style.offsetDistance = `${currentProgress * 100}%`;

                const progressBar = document.getElementById('journey-progress-bar');
                if(progressBar) progressBar.style.width = `${currentProgress * 100}%`;

                if (world) {
                    const cx = paddingX + (currentProgress * (totalNodes - 1)) * spacingX;
                    const viewportWidth = window.innerWidth;
                    const halfScreen = viewportWidth / 2;
                    const maxCameraScroll = Math.max(0, worldWidth - viewportWidth);
                    let cameraX = 0;
                    if (cx > halfScreen && cx < (worldWidth - halfScreen)) {
                        cameraX = cx - halfScreen;
                    } else if (cx >= (worldWidth - halfScreen)) {
                        cameraX = maxCameraScroll;
                    }
                    world.style.transform = `translateX(-${cameraX}px)`;
                }

                if (t < 1) {
                    animationFrame = requestAnimationFrame(step);
                } else {
                    activeIndex = targetIndex;
                    updateMilestoneStates();

                    if (isPlaying) {
                        if (activeIndex < totalNodes - 1) {
                            holdTimeout = setTimeout(() => {
                                animateToNode(activeIndex + 1);
                            }, HOLD_DURATION);
                        } else {
                            isPlaying = false;
                            updatePlayBtnUI();
                        }
                    }
                }
            }
            animationFrame = requestAnimationFrame(step);
        }

        window.journeyController = {
            play: () => {
                if (isPlaying || activeIndex >= totalNodes - 1) return;
                isPlaying = true;
                updatePlayBtnUI();
                holdTimeout = setTimeout(() => {
                    animateToNode(activeIndex + 1);
                }, HOLD_DURATION);
            },
            pause: () => {
                isPlaying = false;
                clearTimeout(holdTimeout);
                cancelAnimationFrame(animationFrame);
                updatePlayBtnUI();
            },
            goTo: (index) => {
                if (index < 0 || index >= totalNodes) return;
                isPlaying = false;
                clearTimeout(holdTimeout);
                cancelAnimationFrame(animationFrame);
                updatePlayBtnUI();
                animateToNode(index);
            },
            togglePlay: () => {
                if (isPlaying) window.journeyController.pause();
                else window.journeyController.play();
            },
            next: () => {
                window.journeyController.goTo(activeIndex + 1);
            },
            prev: () => {
                window.journeyController.goTo(activeIndex - 1);
            }
        };

        function updatePlayBtnUI() {
            const btnText = document.getElementById('journey-play-text');
            const btnIcon = document.getElementById('journey-play-icon');
            if (btnText && btnIcon) {
                if (isPlaying) {
                    btnText.textContent = "Pause";
                    btnIcon.className = "ph-fill ph-pause";
                } else {
                    btnText.textContent = "Auto Play";
                    btnIcon.className = "ph-fill ph-play";
                }
            }
        }

        setTimeout(() => {
            activeIndex = 0;
            currentProgress = 0;
            updateMilestoneStates();
            if(avatar) avatar.style.offsetDistance = `0%`;
            const progressBar = document.getElementById('journey-progress-bar');
            if(progressBar) progressBar.style.width = `0%`;
        }, 100);

        // Attach manual control listeners
        const playBtn = document.getElementById('journey-play-btn');
        if (playBtn) playBtn.addEventListener('click', () => window.journeyController.togglePlay());

        const prevBtn = document.getElementById('journey-prev-btn');
        if (prevBtn) prevBtn.addEventListener('click', () => window.journeyController.prev());

        const nextBtn = document.getElementById('journey-next-btn');
        if (nextBtn) nextBtn.addEventListener('click', () => window.journeyController.next());

        // Attach click listeners to cards
        cards.forEach(card => {
            card.addEventListener('click', () => {
                const idx = parseInt(card.getAttribute('data-index'));
                const pointIndex = points.findIndex(p => p.origIndex === idx);
                if (pointIndex !== -1 && pointIndex !== activeIndex) {
                    window.journeyController.goTo(pointIndex);
                }
            });
        });

        // Scrubber click interaction
        const scrubberBg = document.getElementById('journey-scrubber-bg');
        if (scrubberBg) {
            scrubberBg.addEventListener('click', (e) => {
                const rect = scrubberBg.getBoundingClientRect();
                const clickX = e.clientX - rect.left;
                const percentage = clickX / rect.width;
                let closestIndex = 0;
                let minDiff = Infinity;
                for (let i = 0; i < totalNodes; i++) {
                    const nodePercentage = i / (Math.max(1, totalNodes - 1));
                    const diff = Math.abs(nodePercentage - percentage);
                    if (diff < minDiff) {
                        minDiff = diff;
                        closestIndex = i;
                    }
                }
                window.journeyController.goTo(closestIndex);
            });
        }

        // View Timeline toggle
        const toggleBtn = document.getElementById('toggle-timeline-btn');
        const desktopView = document.getElementById('desktop-journey-container');
        const mobileView = document.getElementById('mobile-timeline-wrapper');

        if (toggleBtn && desktopView && mobileView) {
            toggleBtn.addEventListener('click', () => {
                const isTimeline = desktopView.classList.contains('hidden');
                if (isTimeline) {
                    desktopView.classList.remove('hidden');
                    desktopView.classList.add('lg:block');
                    mobileView.classList.add('lg:hidden');
                    toggleBtn.textContent = 'View Timeline';
                } else {
                    desktopView.classList.add('hidden');
                    desktopView.classList.remove('lg:block');
                    mobileView.classList.remove('lg:hidden');
                    toggleBtn.textContent = 'View Interactive Journey';
                }
            });
        }

        // IntersectionObserver to pause auto-play when off-screen
        const section = document.getElementById('desktop-journey-container');
        if (section) {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (!entry.isIntersecting && isPlaying) {
                        window.journeyController.pause();
                    }
                });
            }, { threshold: 0.1 });
            observer.observe(section);
        }

    });
</script>
