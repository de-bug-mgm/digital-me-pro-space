---
---

<!-- FAB Button -->
<button
  id="chat-fab"
  class="fixed bottom-6 right-6 p-4 bg-blue-600 hover:bg-blue-700 text-white rounded-full shadow-lg hover:shadow-xl transition-all z-40 flex items-center gap-2 font-medium"
  aria-label="Open AI Chat"
>
  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
  </svg>
  <span class="hidden md:inline">Chat with AI</span>
</button>

<!-- Backdrop -->
<div id="chat-backdrop" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-40 hidden opacity-0 transition-opacity"></div>

<!-- Drawer -->
<div
  id="chat-drawer"
  class="fixed bottom-0 right-0 w-full md:w-[400px] h-[80vh] md:h-[600px] bg-white dark:bg-gray-900 shadow-2xl z-50 transform translate-y-full transition-transform duration-300 flex flex-col md:rounded-tl-2xl md:bottom-6 md:right-6 md:h-[600px]"
>
  <!-- Header -->
  <div class="p-4 border-b border-gray-200 dark:border-gray-800 flex justify-between items-center bg-gray-50 dark:bg-gray-800 md:rounded-tl-2xl">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900 flex items-center justify-center text-blue-600 dark:text-blue-400">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
      </div>
      <h3 class="font-bold">Ask my AI Assistant</h3>
    </div>
    <button id="close-chat" class="p-2 text-gray-500 hover:bg-gray-200 dark:hover:bg-gray-700 rounded-full transition-colors">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Chat Window -->
  <div id="chat-messages" class="flex-1 overflow-y-auto p-4 space-y-4">
    <!-- AI Welcome Message -->
    <div class="flex gap-3">
      <div class="w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900 flex-shrink-0 flex items-center justify-center text-blue-600 dark:text-blue-400">AI</div>
      <div class="bg-gray-100 dark:bg-gray-800 rounded-2xl rounded-tl-sm p-3 text-sm max-w-[85%] text-gray-800 dark:text-gray-200">
        Hi there! I'm an AI assistant trained on this portfolio. What would you like to know about my experience, skills, or projects?
      </div>
    </div>
  </div>

  <!-- Suggested Prompts -->
  <div class="px-4 pb-2 flex gap-2 overflow-x-auto no-scrollbar" id="suggested-prompts">
    <button class="prompt-chip whitespace-nowrap px-3 py-1.5 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 rounded-full text-xs font-medium transition-colors border border-gray-200 dark:border-gray-700">What is your experience with C#?</button>
    <button class="prompt-chip whitespace-nowrap px-3 py-1.5 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 rounded-full text-xs font-medium transition-colors border border-gray-200 dark:border-gray-700">Summarize your projects</button>
  </div>

  <!-- Input Area -->
  <div class="p-4 border-t border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900">
    <form id="chat-form" class="flex gap-2">
      <input
        type="text"
        id="chat-input"
        placeholder="Type your message..."
        class="flex-1 bg-gray-100 dark:bg-gray-800 border-none rounded-full px-4 py-2 focus:ring-2 focus:ring-blue-500 outline-none text-sm"
        autocomplete="off"
      />
      <button
        type="submit"
        id="send-btn"
        class="p-2 bg-blue-600 hover:bg-blue-700 text-white rounded-full transition-colors flex items-center justify-center disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <svg class="w-5 h-5 ml-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
        </svg>
      </button>
    </form>
  </div>
</div>

<script>
  const fab = document.getElementById('chat-fab');
  const drawer = document.getElementById('chat-drawer');
  const backdrop = document.getElementById('chat-backdrop');
  const closeBtn = document.getElementById('close-chat');
  const chatForm = document.getElementById('chat-form');
  const chatInput = document.getElementById('chat-input') as HTMLInputElement;
  const messagesContainer = document.getElementById('chat-messages');
  const sendBtn = document.getElementById('send-btn') as HTMLButtonElement;
  const promptChips = document.querySelectorAll('.prompt-chip');

  let isChatOpen = false;

  const toggleChat = () => {
    isChatOpen = !isChatOpen;

    if (isChatOpen) {
      drawer?.classList.remove('translate-y-full');
      backdrop?.classList.remove('hidden');
      setTimeout(() => backdrop?.classList.remove('opacity-0'), 10);
      chatInput?.focus();
    } else {
      drawer?.classList.add('translate-y-full');
      backdrop?.classList.add('opacity-0');
      setTimeout(() => backdrop?.classList.add('hidden'), 300);
    }
  };

  fab?.addEventListener('click', toggleChat);
  closeBtn?.addEventListener('click', toggleChat);
  backdrop?.addEventListener('click', toggleChat);

  const appendMessage = (text: string, isUser: boolean) => {
    if (!messagesContainer) return;

    const msgDiv = document.createElement('div');
    msgDiv.className = `flex gap-3 ${isUser ? 'flex-row-reverse' : ''}`;

    const avatar = document.createElement('div');
    avatar.className = `w-8 h-8 rounded-full flex-shrink-0 flex items-center justify-center text-xs font-bold ${
      isUser ? 'bg-gray-800 text-white dark:bg-gray-200 dark:text-gray-900' : 'bg-blue-100 dark:bg-blue-900 text-blue-600 dark:text-blue-400'
    }`;
    avatar.textContent = isUser ? 'You' : 'AI';

    const bubble = document.createElement('div');
    bubble.className = `rounded-2xl p-3 text-sm max-w-[85%] ${
      isUser
        ? 'bg-blue-600 text-white rounded-tr-sm'
        : 'bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200 rounded-tl-sm'
    }`;
    bubble.textContent = text;

    msgDiv.appendChild(avatar);
    msgDiv.appendChild(bubble);
    messagesContainer.appendChild(msgDiv);

    // Scroll to bottom
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
  };

  const setLoading = (loading: boolean) => {
    if (!chatInput || !sendBtn) return;
    chatInput.disabled = loading;
    sendBtn.disabled = loading;
    if (loading) {
      sendBtn.innerHTML = '<svg class="animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';
    } else {
      sendBtn.innerHTML = '<svg class="w-5 h-5 ml-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>';
      chatInput.focus();
    }
  };

  const handleSend = async (message: string) => {
    if (!message.trim()) return;

    appendMessage(message, true);
    if (chatInput) chatInput.value = '';
    setLoading(true);

    try {
      const response = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message }),
      });

      if (!response.ok) throw new Error('API request failed');

      const data = await response.json();
      appendMessage(data.reply, false);
    } catch (error) {
      console.error(error);
      appendMessage('Sorry, I encountered an error. Please try again later.', false);
    } finally {
      setLoading(false);
    }
  };

  chatForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (chatInput?.value) handleSend(chatInput.value);
  });

  promptChips.forEach(chip => {
    chip.addEventListener('click', () => {
      const text = chip.textContent;
      if (text) handleSend(text);
    });
  });
</script>

<style>
  /* Hide scrollbar for prompts */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
</style>