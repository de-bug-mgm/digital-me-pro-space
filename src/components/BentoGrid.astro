---
import BentoCard from './BentoCard.astro';

interface Props {
  skills: {
    backend: string[];
    frontend: string[];
    devops: string[];
  };
  experience: {
    company: string;
    role: string;
    period: string;
    highlights: string[];
  }[];
  projects: {
    title: string;
    description: string;
    tags: string[];
    link: string;
  }[];
}

const { skills, experience, projects } = Astro.props;
const featuredProject = projects[0];
const sideProject = projects[1];
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 pb-20">
  <!-- Card 1: Featured Project -->
  <BentoCard title="Featured Project" span={2} className="group hover:border-blue-500 transition-colors">
    <div class="flex flex-col h-full justify-between">
      <div>
        <h4 class="text-2xl font-bold mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">{featuredProject.title}</h4>
        <p class="text-gray-600 dark:text-gray-400 mb-6">{featuredProject.description}</p>
      </div>
      <div class="flex flex-wrap gap-2 mb-4">
        {featuredProject.tags.map((tag) => (
          <span class="px-3 py-1 bg-gray-200 dark:bg-gray-800 text-sm rounded-full font-medium">{tag}</span>
        ))}
      </div>
      <a href={featuredProject.link} target="_blank" class="inline-flex items-center text-blue-600 dark:text-blue-400 font-medium hover:underline">
        View Project
        <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </BentoCard>

  <!-- Card 2: Skills -->
  <BentoCard title="Tech Stack">
    <div class="space-y-4">
      <div>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-2 font-medium">Backend</p>
        <div class="flex flex-wrap gap-2">
          {skills.backend.map(skill => <span class="px-2 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-200 text-xs rounded font-medium">{skill}</span>)}
        </div>
      </div>
      <div>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-2 font-medium">Frontend</p>
        <div class="flex flex-wrap gap-2">
          {skills.frontend.map(skill => <span class="px-2 py-1 bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-200 text-xs rounded font-medium">{skill}</span>)}
        </div>
      </div>
      <div>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-2 font-medium">DevOps</p>
        <div class="flex flex-wrap gap-2">
          {skills.devops.map(skill => <span class="px-2 py-1 bg-purple-100 dark:bg-purple-900/30 text-purple-800 dark:text-purple-200 text-xs rounded font-medium">{skill}</span>)}
        </div>
      </div>
    </div>
  </BentoCard>

  <!-- Card 3: Experience -->
  <BentoCard title="Experience" span={2}>
    <div class="space-y-6">
      {experience.map(job => (
        <div class="relative pl-6 border-l-2 border-gray-200 dark:border-gray-800 last:pb-0">
          <div class="absolute w-3 h-3 bg-blue-500 rounded-full -left-[7px] top-1.5 ring-4 ring-white dark:ring-gray-900"></div>
          <h4 class="text-lg font-bold">{job.role}</h4>
          <div class="flex justify-between items-center mb-2">
            <span class="text-gray-600 dark:text-gray-400 font-medium">{job.company}</span>
            <span class="text-sm text-gray-500">{job.period}</span>
          </div>
          <ul class="list-disc list-inside text-gray-600 dark:text-gray-400 text-sm space-y-1">
            {job.highlights.map(h => <li>{h}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </BentoCard>

  <!-- Card 4: Side Project -->
  <BentoCard title="Other Work" className="group hover:border-blue-500 transition-colors">
    <div class="flex flex-col h-full justify-between">
      <div>
        <h4 class="text-lg font-bold mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">{sideProject.title}</h4>
        <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">{sideProject.description}</p>
      </div>
      <div class="flex flex-wrap gap-2 mb-4">
        {sideProject.tags.map((tag) => (
          <span class="px-2 py-1 bg-gray-200 dark:bg-gray-800 text-xs rounded-full font-medium">{tag}</span>
        ))}
      </div>
      <a href={sideProject.link} target="_blank" class="inline-flex items-center text-sm text-blue-600 dark:text-blue-400 font-medium hover:underline">
        View Project
      </a>
    </div>
  </BentoCard>
</div>