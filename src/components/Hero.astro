---
interface Props {
    name: string;
    title: string;
    shortBio: string;
    links: {
        github: string;
        linkedin: string;
        email: string;
    };
}

const { name, title, shortBio, links } = Astro.props;
---

<!-- Hero Section -->
<div class="flex flex-col-reverse md:flex-row items-center gap-12 md:gap-20 mb-20">
    <div class="flex-1 text-center md:text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 dark:bg-brand-500/10 text-brand-600 dark:text-brand-400 text-sm font-semibold mb-6 border border-brand-200 dark:border-brand-500/20">
            <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-500"></span>
            </span>
            Available for new opportunities
        </div>
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-6 leading-tight">
            {name} <br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-500 to-cyan-500">{title}.</span>
        </h1>
        <p class="text-lg md:text-xl leading-relaxed text-slate-600 dark:text-slate-400 max-w-2xl mb-8">
            {shortBio}
        </p>
        <div class="flex items-center justify-center md:justify-start gap-4">
            <a href={`mailto:${links.email}`} class="px-6 py-3 rounded-full bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-semibold hover:scale-105 transition-transform flex items-center gap-2 shadow-lg shadow-slate-900/20 dark:shadow-white/10">
                <i class="ph-bold ph-envelope-simple"></i> Get in touch
            </a>
            <a href={links.github} class="w-12 h-12 flex items-center justify-center rounded-full bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-300 dark:hover:bg-slate-700 transition-colors" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
                <i class="ph-fill ph-github-logo text-xl"></i>
            </a>
            <a href={links.linkedin} class="w-12 h-12 flex items-center justify-center rounded-full bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-300 dark:hover:bg-slate-700 transition-colors" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
                <i class="ph-fill ph-linkedin-logo text-xl"></i>
            </a>
        </div>
    </div>
    <!-- Abstract Hero Graphic instead of Image -->
    <div class="w-48 h-48 md:w-72 md:h-72 relative flex-shrink-0">
        <div class="absolute inset-0 bg-gradient-to-tr from-brand-400 to-cyan-400 rounded-[2rem] rotate-6 opacity-20 animate-pulse"></div>
        <div class="absolute inset-0 bg-slate-900 dark:bg-slate-800 rounded-[2rem] -rotate-3 border border-slate-200 dark:border-slate-700 shadow-2xl flex items-center justify-center overflow-hidden">
            <i class="ph-duotone ph-code text-6xl md:text-8xl text-brand-500 opacity-80"></i>
        </div>
    </div>
</div>