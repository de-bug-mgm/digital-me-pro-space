<div class="fixed top-6 left-0 right-0 z-40 flex justify-center px-4 pointer-events-none">
    <nav class="glass-nav rounded-full px-2 py-2 flex items-center gap-1 md:gap-2 shadow-lg pointer-events-auto">
        <a href="#" data-target="page-home" class="nav-link active px-4 py-2 rounded-full text-sm font-semibold transition-all hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200">Home</a>
        <a href="#" data-target="page-experience" class="nav-link px-4 py-2 rounded-full text-sm font-semibold transition-all hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200">Experience</a>
        <a href="#" data-target="page-projects" class="nav-link px-4 py-2 rounded-full text-sm font-semibold transition-all hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200">Projects</a>

        <div class="w-px h-6 bg-slate-300 dark:bg-slate-700 mx-2"></div>

        <!-- Theme Toggle -->
        <button id="theme-toggle" class="p-2 rounded-full text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors focus:outline-none" aria-label="Toggle Theme">
            <i class="ph ph-moon text-lg dark:hidden block"></i>
            <i class="ph ph-sun text-lg hidden dark:block"></i>
        </button>
    </nav>
</div>

<script>
    // --- SPA Routing Logic ---
    const navLinks = document.querySelectorAll('.nav-link');
    const pages = document.querySelectorAll('.page');

    navLinks.forEach(link => {
        link.addEventListener('click', (e) => {
            e.preventDefault();
            const targetId = link.getAttribute('data-target');

            // Update Nav State
            navLinks.forEach(l => l.classList.remove('active'));
            link.classList.add('active');

            // Update Page State
            pages.forEach(page => {
                if (page.id === targetId) {
                    page.classList.add('active');
                } else {
                    page.classList.remove('active');
                }
            });
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    });

    // Theme Toggle Logic
    const themeToggleBtn = document.getElementById('theme-toggle');

    themeToggleBtn?.addEventListener('click', () => {
        if (document.documentElement.classList.contains('dark')) {
            document.documentElement.classList.remove('dark');
            localStorage.setItem('color-theme', 'light');
        } else {
            document.documentElement.classList.add('dark');
            localStorage.setItem('color-theme', 'dark');
        }
    });
</script>