---
interface Props {
  className?: string;
  title?: string;
  span?: number;
}

const { className = '', title, span = 1 } = Astro.props;
---

<div
  class={`rounded-3xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-800 p-6 flex flex-col ${span === 2 ? 'md:col-span-2' : ''} ${className}`}
>
  {title && <h3 class="text-xl font-bold mb-4">{title}</h3>}
  <div class="flex-grow">
    <slot />
  </div>
</div>