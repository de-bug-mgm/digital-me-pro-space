---
interface Project {
    title: string;
    description: string;
    tags: string[];
    link: string;
}

interface Props {
    projects: Project[];
}

const { projects } = Astro.props;

// A helper array of icons and colors for projects (cycles through them if there are many)
const themeData = [
    { icon: 'ph-leaf', color: 'brand', bgHover: 'bg-brand-500/20', textIcon: 'text-brand-500' },
    { icon: 'ph-kanban', color: 'blue', bgHover: 'bg-blue-500/20', textIcon: 'text-blue-500' },
    { icon: 'ph-rocket', color: 'purple', bgHover: 'bg-purple-500/20', textIcon: 'text-purple-500' },
    { icon: 'ph-lightning', color: 'amber', bgHover: 'bg-amber-500/20', textIcon: 'text-amber-500' }
];
---

<!-- PAGE: PROJECTS -->
<div id="page-projects" class="page">
<h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-3">Featured Projects</h2>
<p class="text-slate-600 dark:text-slate-400 mb-12">Some of the impactful work I've delivered.</p>

<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {projects.map((project, index) => {
        const theme = themeData[index % themeData.length];
        return (
            <div class="group bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm hover:shadow-xl transition-all hover:-translate-y-1 flex flex-col h-full">
                <div class="h-48 bg-slate-100 dark:bg-slate-800 relative overflow-hidden flex items-center justify-center">
                    <div class={`absolute inset-0 ${theme.color === 'brand' ? 'bg-brand-500/10 group-hover:bg-brand-500/20' : `bg-${theme.color}-500/10 group-hover:bg-${theme.color}-500/20`} transition-colors`}></div>
                    <i class={`ph-duotone ${theme.icon} text-6xl ${theme.textIcon} transform group-hover:scale-110 transition-transform duration-500`}></i>
                </div>
                <div class="p-6 flex flex-col flex-1">
                    <div class="flex justify-between items-start mb-4">
                        <h3 class="text-xl font-bold text-slate-900 dark:text-white">{project.title}</h3>
                        <a href={project.link} target="_blank" rel="noopener noreferrer" class={`text-slate-400 hover:${theme.textIcon} transition-colors`} aria-label="View Project">
                            <i class="ph-bold ph-arrow-up-right text-xl"></i>
                        </a>
                    </div>
                    <p class="text-slate-600 dark:text-slate-400 mb-6 flex-1 text-sm leading-relaxed">
                        {project.description}
                    </p>
                    <div class="flex flex-wrap gap-2 mt-auto">
                        {project.tags.map(tag => (
                            <span class="px-2.5 py-1 text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-md">{tag}</span>
                        ))}
                    </div>
                </div>
            </div>
        );
    })}
</div>
</div>
